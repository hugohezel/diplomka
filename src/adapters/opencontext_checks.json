{
  "$schema": "../searchability/translation.schema.json",
  "version": 2,
  "repository": "opencontext",
  "catalogue": "searchability-v1",
  "registries": "core-v1",
  "sources": [
    "https://opencontext.org/about/services",
    "https://opencontext.org/contexts/item.json",
    "https://www.dublincore.org/specifications/dublin-core/dcmi-terms/",
    "https://opencontext.org/projects/3585b372-8d2d-436c-9a4c-b5c10fce3ccd.json",
    "https://opencontext.org/projects/3de4cd9c-259e-4c14-9b03-8b10454ba66e.json",
    "https://opencontext.org/projects/416a274c-cf88-4471-3e31-93db825e9e4a.json",
    "https://opencontext.org/subjects/c4f88b9c-aee0-430a-baad-083f5dfda8fd.json"
  ],
  "bindings": {
    "dataset_ids": [
      {"path": "id", "namespace": "opencontext_record", "level": "object"},
      {"path": "uuid", "namespace": "uuid", "level": "object"},
      {"path": "dc-terms:identifier[]", "level": "object"}
    ],
    "titles": ["dc-terms:title", "label"],
    "descriptions": [
      {"path": "dc-terms:description[].@en", "language": "en", "html": true, "complete": false},
      {"path": "dc-terms:abstract[].@en", "language": "en", "html": true, "complete": false}
    ],
    "terms": [
      "dc-terms:subject[].label",
      "dc-terms:coverage[].label",
      "dc-terms:temporal[].label"
    ],
    "controlled_subjects": [
      {"path": "dc-terms:subject[]", "fields": {"id": "id", "label": "label"}},
      {"path": "dc-terms:coverage[]", "fields": {"id": "id", "label": "label"}},
      {"path": "dc-terms:temporal[]", "fields": {"id": "id", "label": "label"}}
    ],
    "data_types": [
      {
        "path": "category",
        "maps": {"value": {
          "oc-gen:cat-data-publication": "Data publication",
          "oc-gen:cat-structure": "Archaeological structure"
        }}
      }
    ],
    "representations": [],
    "entities": [],
    "files": [
      {
        "path": "oc-gen:has-files[]",
        "fields": {"name": "id", "format": "dc-terms:hasFormat", "role": "type"},
        "complete": false
      }
    ],
    "actors": [
      {
        "path": "dc-terms:creator[]",
        "fields": {"name": "label", "type": "type"},
        "identifiers": {"opencontext_record": "id", "url": "dc-terms:identifier"},
        "role": "Creator",
        "maps": {"type": {
          "https://xmlns.com/foaf/spec/#term_Person": "person",
          "http://xmlns.com/foaf/0.1/Person": "person",
          "https://xmlns.com/foaf/spec/#term_Organization": "organization",
          "http://xmlns.com/foaf/0.1/Organization": "organization"
        }}
      },
      {
        "path": "dc-terms:contributor[]",
        "fields": {"name": "label", "type": "type"},
        "identifiers": {"opencontext_record": "id", "url": "dc-terms:identifier"},
        "role": "Contributor",
        "maps": {"type": {
          "https://xmlns.com/foaf/spec/#term_Person": "person",
          "http://xmlns.com/foaf/0.1/Person": "person",
          "https://xmlns.com/foaf/spec/#term_Organization": "organization",
          "http://xmlns.com/foaf/0.1/Organization": "organization"
        }}
      }
    ],
    "institutions": [],
    "dates": [
      {"path": "dc-terms:issued", "event": "publication"},
      {"path": "dc-terms:modified", "event": "update"}
    ],
    "spatial": [
      {"path": "dc-terms:spatial[]", "fields": {"place": "label"}, "scope": "dataset"},
      {"path": "features[]", "fields": {"geometry": "geometry"}, "scope": "dataset", "crs": "EPSG:4326"}
    ],
    "temporal": [
      {
        "path": "features[].when",
        "fields": {"start": "start", "end": "stop"},
        "event": "coverage",
        "parser": "iso_extended"
      }
    ],
    "production_items": [],
    "production_text": [],
    "relations": [
      {"path": "dc-terms:isPartOf[]", "fields": {"target": "id"}, "predicate": "isPartOf", "direction": "dataset_to_target", "complete": false},
      {"path": "dc-terms:hasPart[]", "fields": {"target": "id"}, "predicate": "hasPart", "direction": "dataset_to_target"},
      {"path": "dc-terms:isReferencedBy[]", "fields": {"target": "id"}, "predicate": "isReferencedBy", "direction": "dataset_to_target"},
      {"path": "dc-terms:references[]", "fields": {"target": "id"}, "predicate": "references", "direction": "dataset_to_target"},
      {"path": "dc-terms:source[]", "fields": {"target": "id"}, "predicate": "isDerivedFrom", "direction": "dataset_to_target"},
      {"path": "dc-terms:isVersionOf[]", "fields": {"target": "id"}, "predicate": "isVersionOf", "direction": "dataset_to_target"},
      {"path": "dc-terms:hasVersion[]", "fields": {"target": "id"}, "predicate": "hasVersion", "direction": "dataset_to_target"},
      {"path": "dc-terms:relation[]", "fields": {"target": "id"}, "predicate": "relation", "direction": "dataset_to_target"}
    ]
  }
}
