{
  "$schema": "../searchability/translation.schema.json",
  "version": 2,
  "repository": "icpsr",
  "catalogue": "searchability-v1",
  "registries": "core-v1",
  "sources": [
    "https://www.icpsr.umich.edu/sites/icpsr/about/repository-operations/accessing-metadata",
    "https://icpsr.github.io/metadata/icpsr_metadata_api/",
    "https://support.datacite.org/docs/api-get-doi",
    "https://datacite-metadata-schema.readthedocs.io/en/4.6/",
    "https://api.datacite.org/dois/10.3886/icpsr35300.v3?affiliation=true&publisher=true"
  ],
  "bindings": {
    "dataset_ids": [
      {
        "path": "data.attributes.doi",
        "namespace": "doi",
        "level": "version"
      }
    ],
    "titles": [
      {
        "path": "data.attributes.titles[]",
        "fields": {
          "value": "title",
          "language": "lang"
        }
      }
    ],
    "descriptions": [
      {
        "path": "data.attributes.descriptions[]",
        "fields": {
          "value": "description",
          "language": "lang"
        },
        "html": true
      }
    ],
    "terms": [
      "data.attributes.subjects[].subject"
    ],
    "data_types": [
      "data.attributes.types.resourceType",
      "data.attributes.types.resourceTypeGeneral"
    ],
    "representations": [],
    "entities": [],
    "actors": [
      {
        "path": "data.attributes.creators[]",
        "fields": {
          "name": "name",
          "given": "givenName",
          "family": "familyName",
          "affiliation": "affiliation[].name",
          "type": "nameType"
        },
        "identifiers": [
          {
            "path": "nameIdentifiers[]",
            "fields": {
              "value": "nameIdentifier",
              "scheme": "nameIdentifierScheme"
            }
          }
        ],
        "maps": {
          "type": {
            "Organizational": "organization",
            "Personal": "person"
          }
        },
        "role": "Creator",
        "name_order": "family_given",
        "complete": false
      },
      {
        "path": "data.attributes.contributors[]",
        "fields": {
          "name": "name",
          "given": "givenName",
          "family": "familyName",
          "affiliation": "affiliation[].name",
          "type": "nameType",
          "role": "contributorType"
        },
        "identifiers": [
          {
            "path": "nameIdentifiers[]",
            "fields": {
              "value": "nameIdentifier",
              "scheme": "nameIdentifierScheme"
            }
          }
        ],
        "maps": {
          "type": {
            "Organizational": "organization",
            "Personal": "person"
          }
        },
        "role": "Contributor",
        "requires_subtype": true,
        "name_order": "family_given",
        "complete": false
      },
      {
        "path": "data.attributes.publisher",
        "fields": {
          "name": "name"
        },
        "identifiers": [
          {
            "path": "",
            "fields": {
              "value": "publisherIdentifier",
              "scheme": "publisherIdentifierScheme"
            }
          }
        ],
        "role": "Publisher",
        "type": "organization",
        "complete": false
      },
      {
        "path": "data.attributes.fundingReferences[]",
        "fields": {
          "name": "funderName"
        },
        "identifiers": [
          {
            "path": "",
            "fields": {
              "value": "funderIdentifier",
              "scheme": "funderIdentifierType"
            },
            "maps": {
              "scheme": {
                "Crossref Funder ID": "doi"
              }
            }
          }
        ],
        "role": "Sponsor",
        "type": "organization",
        "complete": false
      }
    ],
    "institutions": [],
    "dates": [
      {
        "path": "data.attributes.publicationYear",
        "event": "publication",
        "parser": "year"
      },
      {
        "path": "data.attributes.dates[]",
        "fields": {
          "value": "date",
          "event": "dateType"
        },
        "parser": "iso_interval"
      }
    ],
    "temporal": [
      {
        "path": "data.attributes.dates[]",
        "fields": {
          "point": "date",
          "event": "dateType"
        },
        "parser": "iso_interval"
      }
    ],
    "spatial": [
      {
        "path": "data.attributes.geoLocations[]",
        "fields": {
          "place": "geoLocationPlace",
          "latitude": "geoLocationPoint.pointLatitude",
          "longitude": "geoLocationPoint.pointLongitude"
        },
        "scope": "dataset",
        "crs": "EPSG:4326",
        "complete": false
      }
    ],
    "production_items": [],
    "production_text": [],
    "relations": [
      {
        "path": "data.attributes.relatedIdentifiers[]",
        "fields": {
          "target": "relatedIdentifier",
          "scheme": "relatedIdentifierType",
          "predicate": "relationType"
        },
        "direction": "dataset_to_target"
      },
      {
        "path": "data.attributes.relatedItems[]",
        "fields": {
          "target": "relatedItemIdentifier.relatedItemIdentifier",
          "scheme": "relatedItemIdentifier.relatedItemIdentifierType",
          "predicate": "relationType"
        },
        "direction": "dataset_to_target"
      }
    ]
  }
}
