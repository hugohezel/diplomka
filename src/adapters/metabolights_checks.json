{
  "$schema": "../searchability/translation.schema.json",
  "version": 2,
  "repository": "metabolights",
  "catalogue": "searchability-v1",
  "registries": "core-v1",
  "sources": [
    "https://www.ebi.ac.uk/metabolights/ws/api/spec.html",
    "https://www.ebi.ac.uk/metabolights/ws/api/spec.json",
    "https://isa-specs.readthedocs.io/en/latest/isatab.html",
    "https://isa-specs.readthedocs.io/en/latest/isajson.html",
    "https://www.ebi.ac.uk/metabolights/ws/studies/MTBLS1?investigation_only=true",
    "https://www.ebi.ac.uk/metabolights/ws/studies/MTBLS3?investigation_only=true"
  ],
  "bindings": {
    "dataset_ids": [
      {"path": "isaInvestigation.studies[].identifier", "namespace": "metabolights_study", "level": "object"}
    ],
    "titles": ["isaInvestigation.studies[].title"],
    "descriptions": ["isaInvestigation.studies[].description"],
    "terms": ["isaInvestigation.studies[].studyDesignDescriptors[].annotationValue"],
    "controlled_subjects": [
      {
        "path": "isaInvestigation.studies[].studyDesignDescriptors[]",
        "if_any": ["termAccession", "termSource.name"],
        "fields": {"id": "termAccession", "label": "annotationValue", "scheme": "termSource.name"}
      }
    ],
    "data_types": [
      "isaInvestigation.studies[].assays[].measurementType.annotationValue",
      "isaInvestigation.studies[].assays[].technologyType.annotationValue"
    ],
    "representations": [],
    "entities": [],
    "variables": [
      {
        "path": "isaInvestigation.studies[].factors[]",
        "fields": {"name": "factorName", "label": "factorType.annotationValue"},
        "scope": "study biological sources and samples"
      }
    ],
    "files": [
      {"path": "isaInvestigation.studies[].filename", "complete": false},
      {"path": "isaInvestigation.studies[].assays[].filename", "complete": false}
    ],
    "actors": [
      {
        "path": "isaInvestigation.studies[].people[]",
        "fields": {"given": "firstName", "family": "lastName", "affiliation": "affiliation", "role": "roles[].annotationValue", "role_text": "roles[].annotationValue"},
        "role": "ContactPerson",
        "name_order": "given_family",
        "maps": {"role": {
          "principal investigator role": "ProjectLeader",
          "Principal Investigator": "ProjectLeader",
          "principal investigator": "ProjectLeader",
          "Author": "Creator",
          "author": "Creator",
          "Research associate": "Researcher",
          "researcher": "Researcher",
          "data collector": "DataCollector",
          "data curator": "DataCurator",
          "submitter": "ContactPerson"
        }}
      }
    ],
    "institutions": [],
    "dates": [
      {"path": "isaInvestigation.studies[].publicReleaseDate", "event": "publication"},
      {"path": "mtblsStudy.modifiedTime", "event": "update"}
    ],
    "spatial": [],
    "temporal": [],
    "production_items": [
      {
        "path": "isaInvestigation.studies[].assays[]",
        "fields": {"name": "technologyType.annotationValue", "scope": "filename"},
        "role": "acquisition"
      }
    ],
    "production_text": [
      "isaInvestigation.studies[].protocols[].description",
      "isaInvestigation.studies[].assays[].technologyPlatform"
    ],
    "relations": [
      {
        "path": "isaInvestigation.studies[].publications[].doi",
        "if_any": [""],
        "namespace": "doi",
        "predicate": "isReferencedBy",
        "direction": "dataset_to_target"
      },
      {
        "path": "isaInvestigation.studies[].publications[].pubMedID",
        "if_any": [""],
        "namespace": "pmid",
        "predicate": "isReferencedBy",
        "direction": "dataset_to_target"
      }
    ]
  }
}
