{
  "$schema": "../searchability/translation.schema.json",
  "version": 2,
  "repository": "mast",
  "catalogue": "searchability-v1",
  "registries": "core-v1",
  "sources": [
    "https://archive.stsci.edu/",
    "https://mast.stsci.edu/api/v0/MastApiTutorial.html",
    "https://mast.stsci.edu/api/v0/_c_a_o_mfields.html",
    "https://mast.stsci.edu/api/v0/_productsfields.html"
  ],
  "bindings": {
    "dataset_ids": [
      {"path": "observation.data[0].obsid", "namespace": "mast_observation", "level": "object"}
    ],
    "titles": ["observation.data[0].obs_title"],
    "descriptions": ["observation.data[0].obs_title"],
    "terms": [
      "observation.data[0].target_classification",
      "observation.data[0].wavelength_region",
      "observation.data[0].filters"
    ],
    "controlled_subjects": [],
    "data_types": [
      {
        "path": "observation.data[0].dataproduct_type",
        "maps": {"value": {
          "image": "Astronomical image", "spectrum": "Astronomical spectrum",
          "sed": "Spectral energy distribution", "timeseries": "Astronomical time series",
          "visibility": "Interferometric visibilities", "eventlist": "Photon event list",
          "cube": "Astronomical data cube", "catalog": "Astronomical source catalogue",
          "engineering": "Engineering telemetry"
        }}
      }
    ],
    "representations": [
      {
        "path": "observation.data[0].dataproduct_type",
        "maps": {"value": {
          "image": "Image", "spectrum": "Spectrum", "sed": "Spectral energy distribution",
          "timeseries": "Time series", "visibility": "Visibility data",
          "eventlist": "Event list", "cube": "Data cube", "catalog": "Catalogue"
        }}
      }
    ],
    "files": [
      {"path": "products[].data[]", "fields": {"name": "productFilename", "role": "productType"}, "complete": false}
    ],
    "actors": [
      {"path": "observation.data[0].proposal_pi", "role": "ProjectLeader", "name_order": "family_given"}
    ],
    "institutions": [],
    "dates": [
      {"path": "observation.data[0].t_obs_release", "event": "publication", "parser": "mjd"}
    ],
    "entities": ["observation.data[0].target_name"],
    "temporal": [
      {"path": "observation.data[0]", "fields": {"start": "t_min", "end": "t_max"}, "event": "collection", "parser": "mjd"}
    ],
    "production_items": [
      {"path": "observation.data[0]", "fields": {"name": "instrument_name"}, "role": "acquisition", "scope": "observation"}
    ],
    "production_text": [],
    "relations": []
  }
}
