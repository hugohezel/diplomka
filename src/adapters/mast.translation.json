{
  "$schema": "../searchability/translation.schema.json",
  "version": 2,
  "repository": "mast",
  "catalogue": "searchability-v1",
  "registries": "core-v1",
  "sources": [
    "https://mast.stsci.edu/api/v0/md_result_formats.html",
    "https://mast.stsci.edu/api/v0/_c_a_o_mfields.html",
    "https://mast.stsci.edu/api/v0/MastApiTutorial.html",
    "https://outerspace.stsci.edu/spaces/MASTDOCS/pages/94962889/Advanced%2BSearch",
    "https://outerspace.stsci.edu/spaces/TESS/pages/30278757/7.0%2B-%2BTips%2Band%2BTricks%2Bto%2BGetting%2BTESS%2BData%2BAt%2BMAST",
    "https://www.ivoa.net/documents/ObsCore/20170509/REC-ObsCore-v1.1-20170509.pdf"
  ],
  "bindings": {
    "dataset_ids": [
      {
        "path": "data[0].obsid",
        "namespace": "mast_observation",
        "level": "object"
      },
      {
        "path": "data[0]",
        "fields": {
          "value": "obs_id",
          "scope": "obs_collection"
        },
        "level": "object"
      }
    ],
    "titles": [
      "data[0].obs_title"
    ],
    "descriptions": [
      "data[0].obs_title"
    ],
    "terms": [
      "data[0].target_classification",
      "data[0].target_name",
      "data[0].wavelength_region",
      "data[0].filters"
    ],
    "controlled_subjects": [],
    "data_types": [
      {
        "path": "data[0].dataproduct_type",
        "maps": {
          "value": {
            "image": "Astronomical image",
            "spectrum": "Astronomical spectrum",
            "sed": "Spectral energy distribution",
            "timeseries": "Astronomical time series",
            "visibility": "Interferometric visibilities",
            "eventlist": "Astronomical event list",
            "cube": "Astronomical data cube",
            "catalog": "Astronomical catalogue",
            "engineering": "Engineering data"
          }
        }
      }
    ],
    "representations": [
      {
        "path": "data[0].dataproduct_type",
        "maps": {
          "value": {
            "image": "Image",
            "spectrum": "Spectrum",
            "sed": "Spectral energy distribution",
            "timeseries": "Time series",
            "visibility": "Visibility data",
            "eventlist": "Event list",
            "cube": "Data cube",
            "catalog": "Catalogue"
          }
        }
      }
    ],
    "files": [
      {
        "path": "data[0].dataURL",
        "if_any": [""],
        "complete": false
      },
      {
        "path": "data[0].jpegURL",
        "if_any": [""],
        "role": "ancillary",
        "complete": false
      }
    ],
    "actors": [
      {
        "path": "data[0].proposal_pi",
        "if_any": [""],
        "role": "ProjectLeader",
        "type": "person",
        "name_order": "family_given"
      }
    ],
    "institutions": [],
    "dates": [
      {
        "path": "data[0].t_obs_release",
        "event": "publication",
        "parser": "mjd"
      }
    ],
    "entities": [
      "data[0].target_name"
    ],
    "variables": [],
    "spatial": [
      {
        "path": "data[0]",
        "fields": {
          "longitude": "s_ra",
          "latitude": "s_dec",
          "geometry": "s_region"
        },
        "scope": "dataset",
        "crs": "ICRS"
      }
    ],
    "temporal": [
      {
        "path": "data[0]",
        "fields": {
          "start": "t_min",
          "end": "t_max"
        },
        "event": "collection",
        "parser": "mjd"
      }
    ],
    "production_items": [
      {
        "path": "data[0]",
        "fields": {
          "name": "instrument_name"
        },
        "role": "acquisition",
        "scope": "observation"
      }
    ],
    "production_text": [
      "data[0].provenance_name"
    ],
    "relations": [
      {
        "path": "data[0].proposal_id",
        "if_any": [""],
        "predicate": "references",
        "direction": "dataset_to_target"
      }
    ]
  }
}
