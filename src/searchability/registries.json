{
  "version": "core-v1",
  "identifiers": {
    "mast_observation": {
      "pattern": "[1-9][0-9]*",
      "integer": true
    },
    "zenodo_record": {
      "pattern": "[1-9][0-9]*",
      "integer": true,
      "prefix_pattern": "https?://(?:www\\.)?zenodo\\.org/(?:records?|api/records)/([1-9][0-9]*)/?",
      "resolver": "https://zenodo.org/records/{value}"
    },
    "doi": {
      "prefixes": [
        "https://doi.org/",
        "http://doi.org/",
        "https://dx.doi.org/",
        "http://dx.doi.org/",
        "doi:"
      ],
      "pattern": "10\\.[0-9]{4,9}/[^\\s]+",
      "resolver": "https://doi.org/{value}",
      "casefold": true
    },
    "orcid": {
      "prefixes": [
        "https://orcid.org/",
        "http://orcid.org/"
      ],
      "strip_trailing_slash": true,
      "uppercase": true,
      "validator": "orcid",
      "resolver": "https://orcid.org/{value}"
    },
    "gnd": {
      "prefixes": [
        "https://d-nb.info/gnd/",
        "http://d-nb.info/gnd/"
      ],
      "strip_trailing_slash": true,
      "uppercase": true,
      "pattern": "[0-9]+(?:-[0-9X])?",
      "resolver": "https://d-nb.info/gnd/{value}",
      "validator": "gnd"
    },
    "url": {
      "aliases": [
        "uri",
        "purl"
      ],
      "validator": "url",
      "resolver": "{value}"
    },
    "handle": {
      "aliases": [
        "hdl"
      ],
      "prefixes": [
        "https://hdl.handle.net/",
        "http://hdl.handle.net/",
        "hdl:"
      ],
      "pattern": "[0-9]+(?:\\.[0-9]+)*/[^\\s]+",
      "resolver": "https://hdl.handle.net/{value}"
    },
    "ark": {
      "pattern": "ark:/[0-9]{5}/[^\\s]+",
      "resolver": "https://n2t.net/{value}",
      "prefix_pattern": "https?://n2t\\.net/(ark:/[0-9]{5}/[^\\s?#]+)"
    },
    "urn": {
      "pattern": "urn:[a-z0-9][a-z0-9-]{1,31}:[^\\s]+"
    },
    "pmid": {
      "prefixes": [
        "https://pubmed.ncbi.nlm.nih.gov/",
        "pmid:"
      ],
      "strip_trailing_slash": true,
      "pattern": "[1-9][0-9]*",
      "resolver": "https://pubmed.ncbi.nlm.nih.gov/{value}/"
    },
    "pmcid": {
      "prefixes": [
        "https://pmc.ncbi.nlm.nih.gov/articles/"
      ],
      "strip_trailing_slash": true,
      "pattern": "PMC[1-9][0-9]*",
      "resolver": "https://pmc.ncbi.nlm.nih.gov/articles/{value}/"
    },
    "arxiv": {
      "prefixes": [
        "https://arxiv.org/abs/",
        "http://arxiv.org/abs/",
        "arxiv:"
      ],
      "pattern": "(?:[0-9]{4}\\.[0-9]{4,5}|[a-z-]+(?:\\.[a-z]{2})?/[0-9]{7})(?:v[1-9][0-9]*)?",
      "resolver": "https://arxiv.org/abs/{value}"
    },
    "isbn": {
      "prefixes": [
        "isbn:"
      ],
      "remove": "[ -]",
      "uppercase": true,
      "validator": "isbn"
    },
    "issn": {
      "aliases": [
        "eissn",
        "lissn"
      ],
      "prefixes": [
        "issn:"
      ],
      "remove": "[ -]",
      "uppercase": true,
      "validator": "issn"
    },
    "ror": {
      "prefixes": [
        "https://ror.org/",
        "http://ror.org/"
      ],
      "pattern": "0[a-hj-km-np-tv-z0-9]{6}[0-9]{2}",
      "validator": "ror",
      "resolver": "https://ror.org/{value}"
    },
    "uuid": {
      "pattern": "[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}"
    },
    "lcsh": {
      "prefixes": [
        "https://id.loc.gov/authorities/subjects/",
        "http://id.loc.gov/authorities/subjects/"
      ],
      "pattern": "sh[0-9]+",
      "resolver": "https://id.loc.gov/authorities/subjects/{value}"
    },
    "efo": {
      "prefixes": [
        "https://www.ebi.ac.uk/efo/",
        "http://www.ebi.ac.uk/efo/"
      ],
      "pattern": "EFO_[0-9]+",
      "resolver": "https://www.ebi.ac.uk/efo/{value}",
      "replacements": {
        "EFO:": "EFO_"
      }
    },
    "mesh": {
      "prefixes": [
        "https://id.nlm.nih.gov/mesh/",
        "http://id.nlm.nih.gov/mesh/"
      ],
      "pattern": "[DC][0-9]{6,9}",
      "resolver": "https://id.nlm.nih.gov/mesh/{value}"
    },
    "fos": {
      "aliases": [
        "oecd",
        "oecd fos",
        "oecd fos 2007"
      ],
      "pattern": "[1-6](?:\\.[0-9]{1,2})?"
    },
    "opencontext_record": {
      "pattern": "(?:projects|subjects|media|documents|tables|persons)/[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}",
      "prefix_pattern": "https?://(?:www\\.)?opencontext\\.org/((?:projects|subjects|media|documents|tables|persons)/[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})/?",
      "casefold": true,
      "resolver": "https://opencontext.org/{value}"
    },
    "metabolights_study": {
      "pattern": "MTBLS[1-9][0-9]*",
      "prefix_pattern": "https?://(?:www\\.)?ebi\\.ac\\.uk/metabolights/(?:studies/|editor/|ws/studies/(?:public/study/)?)?(MTBLS[1-9][0-9]*)/?",
      "replacements": {
        "MTBLS": "MTBLS"
      },
      "resolver": "https://www.ebi.ac.uk/metabolights/{value}"
    },
    "cern_record": {
      "pattern": "[1-9][0-9]*",
      "integer": true,
      "prefixes": [
        "oai:cernopendata.cern:",
        "cern-open-data:"
      ],
      "prefix_pattern": "https?://opendata\\.cern\\.ch/(?:record|api/records)/([1-9][0-9]*)/?",
      "resolver": "https://opendata.cern.ch/record/{value}"
    },
    "ena_study": {
      "pattern": "(?:PRJ[EDN][A-Z][0-9]+|[EDS]RP[0-9]{6,})",
      "uppercase": true,
      "detect_bare": true,
      "prefix_pattern": "https?://(?:www\\.)?ebi\\.ac\\.uk/ena/browser/view/((?:PRJ[EDN][A-Z][0-9]+|[EDS]RP[0-9]{6,}))/?",
      "resolver": "https://www.ebi.ac.uk/ena/browser/view/{value}"
    },
    "ncbi_taxonomy": {
      "pattern": "[1-9][0-9]*",
      "integer": true,
      "prefixes": [
        "taxon:"
      ],
      "prefix_pattern": "https?://(?:www\\.)?ebi\\.ac\\.uk/ena/taxonomy/rest/tax-id/([1-9][0-9]*)/?",
      "resolver": "https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?id={value}"
    },
    "mhd_study": {
      "pattern": "MHD[A-Z]?[0-9]{6,8}",
      "uppercase": true,
      "detect_bare": true
    },
    "opencontext_slug": {
      "pattern": "[A-Za-z0-9_-]{1,200}"
    },
    "openml_dataset": {
      "pattern": "[1-9][0-9]*",
      "integer": true,
      "prefixes": [
        "openml:"
      ],
      "prefix_pattern": "https?://(?:www\\.|api\\.)?openml\\.org/(?:d|search/data|api/v1/json/data)/([1-9][0-9]*)/?",
      "resolver": "https://www.openml.org/d/{value}"
    },
    "openneuro_dataset": {
      "pattern": "ds[0-9]{6,}",
      "casefold": true,
      "detect_bare": true,
      "prefix_pattern": "https?://(?:www\\.)?openneuro\\.org/datasets/(ds[0-9]{6,})/?",
      "resolver": "https://openneuro.org/datasets/{value}"
    },
    "openneuro_snapshot": {
      "pattern": "ds[0-9]{6,}:(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){2}",
      "casefold": true,
      "detect_bare": true
    },
    "nomad_entry": {
      "pattern": "[A-Za-z0-9_-]{28}",
      "resolver": "https://nomad-lab.eu/prod/v1/api/v1/entries/{value}"
    },
    "nomad_dataset": {
      "pattern": "[A-Za-z0-9_-]{22}",
      "resolver": "https://nomad-lab.eu/prod/v1/api/v1/datasets/{value}"
    },
    "nomad_upload": {
      "pattern": "[A-Za-z0-9_-]{22}",
      "resolver": "https://nomad-lab.eu/prod/v1/api/v1/uploads/{value}"
    },
    "nomad_pid": {
      "pattern": "[0-9]+",
      "integer": true
    },
    "chebi": {
      "pattern": "CHEBI_[1-9][0-9]*",
      "uppercase": true,
      "detect_bare": true,
      "prefix_pattern": "https?://purl\\.obolibrary\\.org/obo/(CHEBI_[1-9][0-9]*)/?",
      "replacements": {
        "CHEBI:": "CHEBI_"
      },
      "resolver": "https://purl.obolibrary.org/obo/{value}"
    },
    "pato": {
      "pattern": "PATO_[0-9]{7}",
      "uppercase": true,
      "detect_bare": true,
      "prefix_pattern": "https?://purl\\.obolibrary\\.org/obo/(PATO_[0-9]{7})/?",
      "replacements": {
        "PATO:": "PATO_",
        "urn:obo:pato:term:": "PATO_"
      },
      "resolver": "https://purl.obolibrary.org/obo/{value}"
    },
    "chmo": {
      "pattern": "CHMO_[0-9]{7}",
      "uppercase": true,
      "detect_bare": true,
      "prefix_pattern": "https?://purl\\.obolibrary\\.org/obo/(CHMO_[0-9]{7})/?",
      "replacements": {
        "CHMO:": "CHMO_"
      },
      "resolver": "https://purl.obolibrary.org/obo/{value}"
    },
    "ncit": {
      "pattern": "NCIT_C[1-9][0-9]*",
      "uppercase": true,
      "detect_bare": true,
      "prefix_pattern": "https?://purl\\.obolibrary\\.org/obo/(NCIT_C[1-9][0-9]*)/?",
      "replacements": {
        "NCIT:": "NCIT_"
      },
      "resolver": "https://purl.obolibrary.org/obo/{value}"
    },
    "geo_accession": {
      "pattern": "(?:GSE|GSM|GPL|GDS)[1-9][0-9]*",
      "uppercase": true,
      "detect_bare": true,
      "resolver": "https://identifiers.org/geo:{value}"
    }
  },
